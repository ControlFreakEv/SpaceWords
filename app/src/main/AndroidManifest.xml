<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ hides other apps unless they are listed here: the text-to-speech engine,
         and the Skylight app that "Back to photos" relaunches. -->
    <queries>
        <package android:name="com.skylight" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="Space Words"
        android:icon="@drawable/ic_ufo"
        android:roundIcon="@drawable/ic_ufo"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar.Fullscreen">

        <!-- Launcher icon only: opens the floating game window (GameWindow) and closes at once. -->
        <activity
            android:name=".GameActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.wordhop.app.game">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The UFO and the floating game window run in their own process (":ufo"). -->
        <service
            android:name=".BubbleService"
            android:process=":ufo"
            android:exported="false" />

        <!-- This frame won't start apps for broadcasts (so BootReceiver doesn't run at boot), but
             it does for services the system binds by itself: these two bring the UFO back after
             a restart (see UfoKeeper.kt). -->
        <service
            android:name=".UfoListener"
            android:process=":ufo"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".UfoJob"
            android:process=":ufo"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".BootReceiver"
            android:process=":ufo"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
