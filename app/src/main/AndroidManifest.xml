<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ hides other apps unless they are listed here: the text-to-speech engine,
         and the Skylight app that "Back to photos" relaunches. -->
    <queries>
        <package android:name="com.skylight" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="Space Words"
        android:icon="@drawable/ic_ufo"
        android:roundIcon="@drawable/ic_ufo"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar.Fullscreen">

        <activity
            android:name=".GameActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.wordhop.app.game"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The UFO runs in its own process: the frame kills the game's process whenever
             another app comes to the front, and the UFO has to survive that. -->
        <service
            android:name=".BubbleService"
            android:process=":ufo"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:process=":ufo"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
